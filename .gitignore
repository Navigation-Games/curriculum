# Source materials (kept locally, not tracked)
background/

# Node / Docusaurus
node_modules/
site/build/
site/.docusaurus/

# Auto-generated by build-content.js from content/ sources.
# These are rebuilt by GitHub Actions on every push. Do not commit them.
# Only index.md files in these directories are hand-maintained and tracked.
# If you add a new hand-maintained file to a generated directory, you MUST
# add a negation rule (! pattern) here so git continues to track it.
site/docs/activities/core/*.md
!site/docs/activities/core/index.md
site/docs/lessons/school/grade-3-5/*.md
!site/docs/lessons/school/grade-3-5/index.md
site/docs/lessons/school/grade-k-2/*.md
!site/docs/lessons/school/grade-k-2/index.md
site/docs/lessons/school/grade-6-plus/*.md
!site/docs/lessons/school/grade-6-plus/index.md

